rthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.2;strokeColor=#8a8a8a;dashed=1;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="inbox_47" target="inbox_45"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="inbox_52" value='&lt;b&gt;Не требует действий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;рассылки, уведомления&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="470" y="676" width="190" height="68" as="geometry"/></mxCell><mxCell id="inbox_53" value="" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.6;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="inbox_3" target="inbox_52"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="415"/><mxPoint x="445" y="710"/></Array></mxGeometry></mxCell><mxCell id="inbox_54" value="Только строка в дайджесте." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1350" y="676" width="330" height="68" as="geometry"/></mxCell><mxCell id="inbox_55" value="" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.2;strokeColor=#8a8a8a;dashed=1;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="inbox_52" target="inbox_54"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="inbox_56" value="&lt;b&gt;Красная стрелка:&lt;/b&gt; Контролёр правил возвращает черновик агенту на правку, если цитаты нет в источнике или есть обещание сверх регламента. Со второго раза — в очередь решений. Письмо от неизвестного адреса тоже идёт в очередь решений.&lt;br&gt;&lt;b&gt;Ответ на наш запрос&lt;/b&gt; закрывает дело, которое открыл Связной или Секретарь встреч. Так замыкается цикл «запрос → ответ»." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="790" width="1680" height="70" as="geometry"/></mxCell><mxCell id="inbox_57" value="&lt;b&gt;Есть наработка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="0" y="880" width="170" height="40" as="geometry"/></mxCell><mxCell id="inbox_58" value="&lt;b&gt;Строим в спринте&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="880" width="170" height="40" as="geometry"/></mxCell><mxCell id="inbox_59" value="&lt;b&gt;Если успеем&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="932" width="170" height="40" as="geometry"/></mxCell><mxCell id="inbox_60" value="&lt;b&gt;Решение руководителя&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="932" width="170" height="40" as="geometry"/></mxCell><mxCell id="inbox_61" value="&lt;b&gt;Оркестратор&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="0" y="984" width="170" height="40" as="geometry"/></mxCell><mxCell id="inbox_62" value="&lt;b&gt;Овал — инструмент, канал&lt;/b&gt;" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fontSize=12;spacing=0;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="980" width="170" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="jtbd" name="JTBD"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="jtbd_1" value="&lt;b&gt;JTBD: какие задачи руководителя решает помощник.&lt;/b&gt; Когда… хочу… чтобы… Боли Б1–Б7 слева, ситуации по очереди работ." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="30" as="geometry"/></mxCell><mxCell id="jtbd_2" value="Боли" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="330" height="760" as="geometry"/></mxCell><mxCell id="jtbd_3" value='&lt;b&gt;Б1 Узкое горлышко&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;все ждут его ответа&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="86" width="290" height="80" as="geometry"/></mxCell><mxCell id="jtbd_4" value='&lt;b&gt;Б2 Встречи без действий&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;решения не записаны&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="188" width="290" height="80" as="geometry"/></mxCell><mxCell id="jtbd_5" value='&lt;b&gt;Б3 Обещания теряются&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;никто не напомнил&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="290" height="80" as="geometry"/></mxCell><mxCell id="jtbd_6" value='&lt;b&gt;Б4 Одни и те же вопросы&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;скидки, регламенты&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="392" width="290" height="80" as="geometry"/></mxCell><mxCell id="jtbd_7" value='&lt;b&gt;Б5 Отчётность вручную&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;апдейт и статус наверх&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="494" width="290" height="80" as="geometry"/></mxCell><mxCell id="jtbd_8" value='&lt;b&gt;Б6 Внимание не доходит&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;команда, партнёры&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="596" width="290" height="80" as="geometry"/></mxCell><mxCell id="jtbd_9" value='&lt;b&gt;Б7 Переключения&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;почта, чаты, созвоны&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="698" width="290" height="80" as="geometry"/></mxCell><mxCell id="jtbd_10" value="Хребет · строим первым" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="360" y="50" width="880" height="190" as="geometry"/></mxCell><mxCell id="jtbd_11" value='&lt;b&gt;J2 Вышел со встречи&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;боли: Б2, Б3&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;набросал итог за минуту, поручения сами ушли со сроками&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="375" y="90" width="270" height="120" as="geometry"/></mxCell><mxCell id="jtbd_12" value='&lt;b&gt;J3 Подходит срок&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;боли: Б3&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;исполнителю напомнили, мне сказали только если застряло&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="665" y="90" width="270" height="120" as="geometry"/></mxCell><mxCell id="jtbd_13" value='&lt;b&gt;J8 Нужен смежник&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;боли: Б1, Б3&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;запрос ушёл, ответ вернулся, дело закрылось без меня&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="955" y="90" width="270" height="120" as="geometry"/></mxCell><mxCell id="jtbd_14" value="Второй слой · входящие, тот же механизм" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="360" y="260" width="880" height="190" as="geometry"/></mxCell><mxCell id="jtbd_15" value='&lt;b&gt;J1 Утро после выходных&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;боли: Б1, Б7&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;пять пунктов, где нужен я, остальное разобрано&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="375" y="300" width="270" height="120" as="geometry"/></mxCell><mxCell id="jtbd_16" value='&lt;b&gt;J4 Типовой вопрос&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;боли: Б1, Б4&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;сотруднику ответили сразу по регламенту моими словами&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="665" y="300" width="270" height="120" as="geometry"/></mxCell><mxCell id="jtbd_17" value='&lt;b&gt;J10 Срочный сбой&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;боли: Б1, Б7&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;ответственный узнал сразу, мне одна строка&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="955" y="300" width="270" height="120" as="geometry"/></mxCell><mxCell id="jtbd_18" value="Если успеем · рассказ на защите" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="360" y="470" width="880" height="340" as="geometry"/></mxCell><mxCell id="jtbd_19" value='&lt;b&gt;J5 Пятница, апдейт&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;боли: Б5, Б6&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;апдейт собрался из дел и ушёл команде сам&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="375" y="510" width="270" height="120" as="geometry"/></mxCell><mxCell id="jtbd_20" value='&lt;b&gt;J6 Статус наверх&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;боли: Б5&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;сводка с цифрами и источниками за 2 минуты&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="665" y="510" width="270" height="120" as="geometry"/></mxCell><mxCell id="jtbd_21" value='&lt;b&gt;J7 Перед встречей&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;боли: Б2, Б3&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;что обещали друг другу и что висит&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="955" y="510" width="270" height="120" as="geometry"/></mxCell><mxCell id="jtbd_22" value='&lt;b&gt;J9 Ключевой партнёр&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;боли: Б6&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;персональное письмо с историей договорённостей&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="375" y="660" width="270" height="120" as="geometry"/></mxCell><mxCell id="jtbd_23" value='&lt;b&gt;J11 Меня нет&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;боли: Б1, Б6&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;рутина идёт, решения ждут в одной очереди&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="665" y="660" width="270" height="120" as="geometry"/></mxCell><mxCell id="jtbd_24" value='&lt;b&gt;Принцип&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;Помощник делает сам. Руководитель узнаёт итог и может отменить. Решает руководитель только то, что требует решения.&lt;br&gt;&lt;br&gt;&lt;b&gt;Метрика:&lt;/b&gt; доля событий, закрытых без руководителя. Аннотация: до 60 %, наша цель выше.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1270" y="50" width="250" height="300" as="geometry"/></mxCell><mxCell id="jtbd_25" value="&lt;b&gt;Есть наработка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1270" y="400" width="170" height="40" as="geometry"/></mxCell><mxCell id="jtbd_26" value="&lt;b&gt;Строим в спринте&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1480" y="400" width="170" height="40" as="geometry"/></mxCell><mxCell id="jtbd_27" value="&lt;b&gt;Если успеем&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1270" y="452" width="170" height="40" as="geometry"/></mxCell><mxCell id="jtbd_28" value="&lt;b&gt;Решение руководителя&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1480" y="452" width="170" height="40" as="geometry"/></mxCell><mxCell id="jtbd_29" value="&lt;b&gt;Оркестратор&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;spacing=2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1270" y="504" width="170" height="40" as="geometry"/></mxCell><mxCell id="jtbd_30" value="&lt;b&gt;Овал — инструмент, канал&lt;/b&gt;" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fontSize=12;spacing=0;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1480" y="500" width="170" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="spine" name="Хребет: встреча → исполнение"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="spine_1" value="&lt;b&gt;Хребет J2 → J3 → J8.&lt;/b&gt; Встреча закончилась, дальше всё происходит без руководителя. Он трогает продукт дважды: заметка и одна кнопка." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="30" as="geometry"/></mxCell><mxCell id="spine_2" value="Руководитель" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="80" width="1800" height="112" as="geometry"/></mxCell><mxCell id="spine_3" value="Диспетчер и роли" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="1800" height="112" as="geometry"/></mxCell><mxCell id="spine_4" value="Контролёр правил" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="320" width="1800" height="112" as="geometry"/></mxCell><mxCell id="spine_5" value="Команда · Telegram" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="440" width="1800" height="112" as="geometry"/></mxCell><mxCell id="spine_6" value="Смежник · почта" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="560" width="1800" height="112" as="geometry"/></mxCell><mxCell id="spine_7" value="Партнёр · почта" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="680" width="1800" height="112" as="geometry"/></mxCell><mxCell id="spine_8" value="&lt;b&gt;0 мин&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="150" y="50" width="190" height="24" as="geometry"/></mxCell><mxCell id="spine_9" value="&lt;b&gt;+1 мин&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="357" y="50" width="190" height="24" as="geometry"/></mxCell><mxCell id="spine_10" value="&lt;b&gt;+1 мин&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="564" y="50" width="190" height="24" as="geometry"/></mxCell><mxCell id="spine_11" value="&lt;b&gt;+1…5 мин&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="771" y="50" width="190" height="24" as="geometry"/></mxCell><mxCell id="spine_12" value="&lt;b&gt;за день до срока&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="978" y="50" width="190" height="24" as="geometry"/></mxCell><mxCell id="spine_13" value="&lt;b&gt;ответ пришёл&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1185" y="50" width="190" height="24" as="geometry"/></mxCell><mxCell id="spine_14" value="&lt;b&gt;срок прошёл&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1392" y="50" width="190" height="24" as="geometry"/></mxCell><mxCell id="spine_15" value="&lt;b&gt;пятница&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1599" y="50" width="190" height="24" as="geometry"/></mxCell><mxCell id="spine_16" value='&lt;b&gt;1. Заметка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;текст или голос&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;«Анне — лендинг к пятнице, маркетингу — статус акции, партнёру — условия»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="110" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_17" value='&lt;b&gt;2. Секретарь встреч&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;DeepSeek V4 Pro&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;кто, что, срок, цитата; нет ли уже такого дела&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="357" y="230" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_18" value='&lt;b&gt;3. Проверка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;код&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;цитаты сверены, «к пятнице» → 28.11&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="564" y="350" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_19" value='&lt;b&gt;4a. Поручение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;сразу&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;«@Анна, лендинг, срок 28.11»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="771" y="470" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_20" value='&lt;b&gt;4b. Запрос&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;сразу&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;маркетингу: статус акции до 27.11&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="771" y="590" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_21" value='&lt;b&gt;4c. Письмо&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;окно отмены&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;партнёру, уходит через 5 мин&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="978" y="710" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_22" value='&lt;b&gt;5. Одна строка&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;пульт&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;«Разослано 3. Партнёру уйдёт в 14:05 [Отменить]»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="771" y="110" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_23" value='&lt;b&gt;6. Контролёр сроков&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;часы&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;до срока сутки, ответа нет&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="978" y="230" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_24" value='&lt;b&gt;Напоминание&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;сразу&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;«@Анна, завтра срок»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="978" y="470" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_25" value='&lt;b&gt;7. Ответ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;письмо&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;«Акция стартует 1.12»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1185" y="590" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_26" value='&lt;b&gt;8. Дело закрыто&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;Разборщик + Связной&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;ответ = новое событие, нашли дело&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1185" y="230" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_27" value='&lt;b&gt;9. Застряло&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;Контролёр сроков&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;Анна молчит после срока&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1392" y="230" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_28" value='&lt;b&gt;10. Решение&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;одна кнопка&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;[Напомнить ещё] [Перенести] [Сам]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1392" y="110" width="190" height="76" as="geometry"/></mxCell><mxCell id="spine_29" value='&lt;b&gt;11. Апдейт&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#1d4ed8"&gt;Летописец&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#333333"&gt;закрыто, застряло, приоритеты&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=2;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1599" y="470" width="190" height="76" as="geometry"/></mxCell><mxCell i