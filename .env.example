# Настройки стенда ИИ-помощника руководителя. Скопируйте в .env и заполните. Ключи в git не кладём.

# Модель: любой OpenAI-совместимый адрес (DeepSeek, GigaChat-шлюз, YandexGPT, локальная модель)
LLM_PRIMARY=anthropic
LLM_FALLBACK=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Профиль руководителя: папка в profiles/
PROFILE=ivan_petrov
LEADER_NAME_GENITIVE=Ивана Петрова

# Telegram-пульт руководителя
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта: yandex (настоящая) или пусто — учебный ящик и заглушка Outlook
MAIL_PROVIDER=yandex
YANDEX_ADDRESS=
YANDEX_APP_PASSWORD=
YANDEX_APP_PASSWORD_KALENDAR=
MAIL_ADDRESS=
MS_TENANT=
MS_CLIENT_ID=

# Аватар LiveAvatar (HeyGen)
HEYGEN_API_KEY=
HEYGEN_LiveAvatar_API_KEY=
LIVEAVATAR_AVATAR_ID=
# Категории встреч, на которые аватар ходит сам (через запятую)
AVATAR_CATEGORIES=операционная

# Телемост: ссылка на встречу создаётся автоматически, если задан OAuth-токен Яндекс 360 для бизнеса
# с правом telemost-api:conferences.create. Пусто — кнопка «Открыть Телемост», ссылку вставляют вручную.
TELEMOST_OAUTH_TOKEN=

# Адрес стенда (для ссылок в Telegram) и учебный рабочий день (пусто — сегодня)
STAND_URL=
DEMO_DATE=
