<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Cursor" version="22.1.0" type="device">
  <diagram id="obyazannosti" name="Обязанности помощника">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="ИИ-помощник" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7EEF1;strokeColor=#245C73;strokeWidth=1.5;arcSize=4;fontColor=#245C73;fontFamily=Arial;fontStyle=1;fontSize=14;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="168" width="1580" height="580" as="geometry" />
        </mxCell>
        <mxCell id="manager" value="Руководитель подразделения онлайн-продаж" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B3A4B;strokeColor=#1B3A4B;fontColor=#FFFFFF;fontFamily=Arial;fontStyle=1;fontSize=18;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="36" width="780" height="64" as="geometry" />
        </mxCell>
        <mxCell id="e-manager" value="туда, где нужно его решение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#1B3A4B;strokeWidth=1.5;fontFamily=Arial;fontSize=13;fontColor=#1B3A4B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="manager" target="frame">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#1B3A4B&quot;&gt;1. Разбирать входящие&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2D3748&quot;&gt;Понять, кому адресован вопрос, насколько он срочный и где требуется решение руководителя.&lt;br&gt;&lt;br&gt;Типовой вопрос — ответ по регламенту.&lt;br&gt;Сбой оплаты — сразу передать ответственному.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A4B;strokeWidth=1.5;arcSize=8;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="54" y="220" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#1B3A4B&quot;&gt;2. Готовить сводки&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2D3748&quot;&gt;Собрать продажи против плана, заказы, конверсию и возвраты.&lt;br&gt;&lt;br&gt;Выделить отклонения.&lt;br&gt;Указать, где причина уже известна, а где её ещё выясняют.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A4B;strokeWidth=1.5;arcSize=8;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="570" y="220" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#1B3A4B&quot;&gt;3. Держать команду в курсе&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2D3748&quot;&gt;Подготовить еженедельный апдейт:&lt;br&gt;&lt;br&gt;что получилось, что мешает,&lt;br&gt;приоритеты на следующую неделю&lt;br&gt;и от кого ждут действий.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A4B;strokeWidth=1.5;arcSize=8;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="1086" y="220" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#1B3A4B&quot;&gt;4. Координировать смежные отделы&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2D3748&quot;&gt;Маркетинг — статус акции.&lt;br&gt;Склад — остатки.&lt;br&gt;ИТ — срок исправления сбоя.&lt;br&gt;&lt;br&gt;Зафиксировать, кто что обещал и к какому сроку.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A4B;strokeWidth=1.5;arcSize=8;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="54" y="450" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#1B3A4B&quot;&gt;5. Готовить персональные обращения&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2D3748&quot;&gt;Перед письмом партнёру поднять историю договорённостей и собрать факты.&lt;br&gt;&lt;br&gt;Черновик с конкретной просьбой или предложением.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A4B;strokeWidth=1.5;arcSize=8;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="570" y="450" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#1B3A4B&quot;&gt;6. Следить за поручениями&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2D3748&quot;&gt;После встречи разослать решения.&lt;br&gt;Напомнить исполнителям про сроки.&lt;br&gt;&lt;br&gt;Сообщить руководителю, если задача застряла.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A4B;strokeWidth=1.5;arcSize=8;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="1086" y="450" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Рабочий перечень до официального ТЗ. Шесть обязанностей идут параллельно, это не порядок шагов." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#245C73;" vertex="1" parent="1">
          <mxGeometry x="54" y="680" width="1100" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
